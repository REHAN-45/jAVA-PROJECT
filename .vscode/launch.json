{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Spring Boot - Launch TeamTaskManagementApplication",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "mainClass": "com.college.taskmgmt.TeamTaskManagementApplication",
      "projectName": "team-task-management",
      "args": "",
      "env": {
        "SPRING_PROFILES_ACTIVE": "dev"
      }
    },
    {
      "name": "Debug Frontend in Chrome (Port 3000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Spring Boot + Frontend",
      "configurations": [
        "Spring Boot - Launch TeamTaskManagementApplication",
        "Debug Frontend in Chrome (Port 3000)"
      ]
    }
  ]
}
